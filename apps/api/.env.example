PROJECT_NAME=ai-mental-wellbeing-copilot
WEB_PORT=5173
API_PORT=8000
POSTGRES_PORT=55432
REDIS_PORT=6379

APP_ENV=local
APP_NAME=AI Mental Wellbeing Copilot API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
APP_DEBUG=true
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=mental_wellbeing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

SCHEDULER_BACKEND=local_contract
TEMPORAL_ENABLED=false
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=mental-wellbeing-followups

CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

OTEL_ENABLED=false
OTEL_SERVICE_NAME=mental-wellbeing-api

DEPLOYMENT_NAME=local
AUTH_MODE=development_bypass
AUTH_SESSION_SECRET=dev-session-secret-change-me
AUTH_ACCESS_TOKEN_TTL_MINUTES=480
AUTH_HEADER_NAME=Authorization
AUTH_COOKIE_NAME=mwc_session
AUTH_ALLOW_DEV_BOOTSTRAP=true
AUTH_ALLOW_DEV_HEADERS=true

ENTERPRISE_DEFAULT_ORG_NAME=Default Enterprise
ENTERPRISE_DEFAULT_ORG_SLUG=default-enterprise
ENTERPRISE_ADMIN_ROLE_NAME=platform_admin

STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.runtime/storage
STORAGE_PUBLIC_BASE_URL=
STORAGE_ARTIFACT_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_STAGE_REMOTE_WRITES_LOCALLY=true
STORAGE_AUDIT_ARTIFACT_PREFIX=audit-artifacts
STORAGE_SAFETY_ARTIFACT_PREFIX=safety-artifacts
STORAGE_ATTACHMENT_PREFIX=attachments

SECRET_BACKEND=env
MANAGED_SECRET_NAMESPACE=mental-wellbeing
MANAGED_SECRET_PREFIX=

QUEUE_MAX_ATTEMPTS=3
QUEUE_DEAD_LETTER_ENABLED=true
QUEUE_MAX_INFLIGHT=100
QUEUE_VISIBILITY_TIMEOUT_SECONDS=900
QUEUE_ENFORCE_IDEMPOTENCY=true

FILE_MAX_ATTACHMENT_BYTES=10485760
FILE_ALLOWED_ATTACHMENT_CONTENT_TYPES=application/json,text/plain,text/markdown
FILE_QUARANTINE_PREFIX=quarantine

CLOUD_DEPLOYMENT_PROFILE=local
CLOUD_CONFIG_SOURCE=env